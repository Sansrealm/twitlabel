{
  "manifest_version": 3,
  "name": "Alien Account for X",
  "version": "1.0.0",
  "description": "Adds an 'Alien account' pill to X accounts based outside your home country. Click the pill to see the country.",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Alien Account settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["countries.js", "content.js"],
      "css": ["pill.css"],
      "run_at": "document_idle"
    }
  ]
}
